<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        th, td {
  border: 1px solid #333;
  padding: 8px;           
  text-align: left;       
}

    </style>

</head>
<body>
    <table style="width: 40%; border-collapse: collapse;">
    <thead>
        <tr>
          <th>Name</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <% dataone.forEach(a => { %>
          <tr>
            <td><%= a.name %></td>
            <td><%= a.price %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>




</body>
</html>