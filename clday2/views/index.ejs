<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    th,td{
       padding: 20px 40px;
       border: solid;
    }
    table{
      margin: auto;
    }
  </style>
<body>
  <h2 style="text-align: center;"><%= store %></h2>
  <table style="padding: 20px; border-collapse: collapse;">

    <tr>
      <th>Title</th>
      <th>Author</th>
    </tr>
 <%  for( a of book){ %>
    <tr>
      <td><%= a.name %></td>
      <td><%= a.author %></td>
    </tr>
     <% } %>
  </table>
</body>
<script src="/javascripts/nn.js"></script>
</html>