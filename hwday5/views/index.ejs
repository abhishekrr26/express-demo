<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        h1{
            text-align: center;
        }
        form{
            margin: auto;
            text-align: center;
            width: 40%;
            height: 400px;
          box-shadow: 2px 4px 6px rgba(0, 0, 0, 0.5);
          margin-top: 50px;
        }
        input{
            margin-top: 50px;
            width: 50%;
            padding: 15px ;
        } 
        .a{
            margin-top: 20px;
        }  
        textarea{
            width: 50%;
            margin-top: 20px;
            height: 90px;
        }   
        button{
            margin-top: 20px;
            width: 30%;
            padding: 10px;
            color: rgb(248, 249, 251);
            background-color: rgb(0, 119, 255);
            border: 0cap;
            border-radius: 5px;
        }  
    </style>
</head>
<body>
    <h1>
        Enter the Product Description
    </h1>
  

        <form action="/product" method="post">

        <input name="name" placeholder="Enter the Product Name">
        <br>

         <% if (error && error.length >0) { %>
    <% error.forEach(function(err) { %>
      <% if (err.path === 'name') { %>
        <p><%= err.msg %></p>
      <% } %>
    <% }) %>
  <% } %>
        <input class="a" name="price" placeholder="Enter the price">
        <br>
  
         <% if (error && error.length >0) { %>
    <% error.forEach(function(err) { %>
      <% if (err.path === 'price') { %>
        <p><%= err.msg %></p>
      <% } %>
    <% }) %>
  <% } %>
        <textarea name="description" placeholder="Enter the Description"></textarea>

        <br>
      
         <% if (error && error.length >0) { %>
    <% error.forEach(function(err) { %>
      <% if (err.path === 'description') { %>
        <p><%= err.msg %></p>
      <% } %>
    <% }) %>
  <% } %>
        <button type="submit">Submit</button>
    </form>


  
    
   

</body>
</html>