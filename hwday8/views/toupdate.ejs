<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/updated/<%= data._id %>" method="post">
  <label for="name">Name:</label>
  <input type="text" id="name" name="name" value="<%= data.name %>"><br>
  <label for="description">Description:</label>
  <textarea id="description" name="description" ><%= data.description %></textarea><br>
  <label for="price">Price:</label>
  <input type="number" id="price" name="price" step="0.01"  value="<%= data.price %>"><br>
  <input type="submit" value="Update Product">
</form>
</body>
</html>