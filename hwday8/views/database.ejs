<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        table{
            border-collapse:collapse ;
            margin: auto;
            
        }
        th,td{
            text-align: center;
            border: 1px solid;
            padding: 10px;
        }
        nav{
            text-align: center;
        }
    </style>
</head>
<body>
     <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(product => { %>
          <tr>
            <td><%= product.name %></td>
            <td><%= product.description %></td>
            <td><%= product.price %></td>
<td>
  <form action="/update/<%= product._id %>" method="GET">
    <button type="submit">Edit</button>
  </form>
</td>
<td>
  <form action="/delete/<%= product._id %>" method="GET">
    <button type="submit">Delete</button>
  </form>
</td>
          </tr>
        <% }); %>
      </tbody>
    </table>
 <nav aria-label="Page navigation example" style="margin:auto;">
    <% if (pagination.hasPrevPage) { %>
      <a href="?page=1">&laquo; first</a>
      <a href="?page=<%= pagination.prevPage %>">&laquo; previous</a>
    <% } %>
 
    <% for (let page_number = 1; page_number <= pagination.totalPages; page_number++) { %>
      <% if (pagination.page === page_number) { %>
        <span ><%= page_number %></span>
      <% } else { %>
        <a href="?page=<%= page_number %>"><%= page_number %></a>
      <% } %>
    <% } %>
 
    <% if (pagination.hasNextPage) { %>
      <a href="?page=<%= pagination.nextPage %>" >next &raquo;</a>
      <a href="?page=<%= pagination.totalPages %>">last &raquo;</a>
    <% } %>
 
  </nav>






</body>
</html>